# ---------------------------------------------------------------------------
# TurboSlop — example environment
#
#   cp .env.example .env      # then fill in what you actually have
#
# Every variable is OPTIONAL. With none of them set, TurboSlop still runs: it
# decides with the local stand-in, keeps canonical copy, and skips artwork.
#
# IMPORTANT: `.env` is gitignored and must never be committed. In production
# use your platform's secret store, or /etc/turboslop/env (chmod 600).
# ---------------------------------------------------------------------------

# ===========================================================================
# 1. DECISIONS — Jev (TypeSafe AI)
# ===========================================================================
# https://typesafe.ai — returns typed decisions with calibrated confidence.
# Without it, a deterministic local decider is used instead.
TYPESAFE_API_KEY=

# auto | live | local      (auto = live when the key above is present)
FORGE_DECIDER=auto

# ===========================================================================
# 2. COPY — any OpenAI-compatible /chat/completions endpoint
# ===========================================================================
# Pick a preset…
FORGE_LLM_PROVIDER=deepseek          # deepseek | openai | openrouter | groq | together | ollama
# …and its key (or set FORGE_LLM_API_KEY for anything else):
DEEPSEEK_API_KEY=

# …or point it anywhere yourself. These override the preset entirely:
# FORGE_LLM_BASE_URL=https://api.example.com/v1
# FORGE_LLM_MODEL=your-model-id
# FORGE_LLM_API_KEY=your-key

# Reasoning budget for models that support it: low | high | max
# FORGE_LLM_EFFORT=low

# ===========================================================================
# 3. IMAGES — any reachable endpoint that speaks this API
# ===========================================================================
# OFF unless FORGE_IMAGE_BASE_URL is set. There is no default host, and no
# assumption about how you reach it. All of these work identically:
#
#   a service on this machine      http://127.0.0.1:8000
#   a service on your LAN          http://192.168.1.50:8000
#   a service behind Tailscale     https://your-host.your-tailnet.ts.net:4363
#   a service behind a VPN/proxy   https://images.internal.example.com
#
# Example, if you run one locally:
# FORGE_IMAGE_BASE_URL=http://127.0.0.1:8000
#
# Example, if it lives on a private tailnet:
# FORGE_IMAGE_BASE_URL=https://your-host.your-tailnet.ts.net:4363
FORGE_IMAGE_BASE_URL=

# --- Allowlist ---------------------------------------------------------------
# localhost is always allowed. Any OTHER hostname must be named here, so a
# crafted request can never turn the app into an arbitrary fetch proxy.
# Comma-separated. Ports are not part of the match — hostnames only.
# FORGE_IMAGE_ALLOW_HOSTS=192.168.1.50,images.internal.example.com,my-host.my-tailnet.ts.net

# Opt out of the allowlist entirely — only do this on a network you trust.
# FORGE_IMAGE_ALLOW_ANY_HOST=1

# --- Auth (only if your service needs more than network reachability) --------
# Sent on every request. Defaults to `Authorization: Bearer <token>`.
# FORGE_IMAGE_TOKEN=
# FORGE_IMAGE_TOKEN_HEADER=Authorization      # or e.g. X-Api-Key
# FORGE_IMAGE_ORIGIN=https://your-host:4363   # only if the service checks Origin

# --- Timing ------------------------------------------------------------------
# FORGE_IMAGE_TIMEOUT_MS=20000        # per-request timeout
# FORGE_IMAGE_POLL_TIMEOUT_MS=180000  # total wait for a job to finish

# ===========================================================================
# 4. SERVER
# ===========================================================================
# FORGE_PORT=4400
# FORGE_OUT_DIR=./out
