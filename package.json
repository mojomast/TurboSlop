{
  "name": "turboslop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TurboSlop — machine-made, human-judged. Jev decides the design, an LLM writes it, a hosted model illustrates it, code composes and ships it.",
  "keywords": ["design", "generative-ui", "jev", "typesafe", "decisions", "ssg"],
  "license": "MIT",
  "engines": { "node": ">=20" },
  "scripts": {
    "serve": "tsx src/server.ts",
    "decide": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx test/forge.test.ts && tsx test/images.test.ts && tsx test/zip.test.ts && tsx test/motifs.test.ts && tsx test/assets.test.ts && tsx test/fonts.test.ts && tsx test/session.test.ts && tsx test/slots.test.ts && tsx test/diversity.test.ts && tsx test/locks.test.ts && tsx test/revision.test.ts && tsx test/assetplan.test.ts",
    "test:forge": "tsx test/forge.test.ts",
    "test:images": "tsx test/images.test.ts",
    "test:zip": "tsx test/zip.test.ts",
    "test:motifs": "tsx test/motifs.test.ts",
    "test:assets": "tsx test/assets.test.ts",
    "test:fonts": "tsx test/fonts.test.ts",
    "test:session": "tsx test/session.test.ts",
    "test:slots": "tsx test/slots.test.ts",
    "test:diversity": "tsx test/diversity.test.ts",
    "test:locks": "tsx test/locks.test.ts",
    "test:revision": "tsx test/revision.test.ts",
    "test:assetplan": "tsx test/assetplan.test.ts",
    "test:viewport": "tsx test/viewport.test.ts",
    "measure": "tsx scripts/measure.ts",
    "matrix": "tsx scripts/render-matrix.ts",
    "sheet-shot": "tsx scripts/sheet-shot.ts",
    "fonts": "tsx scripts/fetch-fonts.ts",
    "curate": "tsx scripts/curate.ts"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
